+    def get_policy_context(
+            context:ToolExecutionContext,
+            arguments:BaseModel,
+    ) -> HarnessToolResult:
+    # **需要补充的逻辑**：
+    # 1. 通过 context.h5_user 拿当前登录用户，没有用户时抛 401
+    # 2. 用 enrollment.list_policies(user) 查当前用户的保单列表，再按 policy_id
+    #    匹配（现有服务没有按保单 ID 单查的公开方法，列表过滤即可）
+    # 3. 只允许 ACTIVE 状态的保单参与续保规划
+    # 4. 保单不存在、不属于当前用户、已失效时，统一抛 RENEWAL_POLICY_NOT_AVAILABLE，
+    #    不要分别提示，避免泄露其他用户保单的存在性
+    # 5. 返回保单号、产品名、计划名、coverage_end 等必要字段（与现有
+    #    policy_data 的字段命名一致），不要返回身份证号等敏感字段
+        args = _arguments(arguments,GetPolicyContext)
+        user = context.h5_user
+        if user is None:
+            raise AppError("AGENT_CUSTOMER_REQUIRED","长期记忆需要H5用户身份",401)
+        polices = enrollment.list_policies(user).items
+        policy_id = args.policy_id
+        origin_policy = None
+        for policy in polices:
+            if policy_id == policy.policy_id:
+                if policy.status == 'ACTIVE':
+                    origin_policy = policy
+
+        if origin_policy == None: 
+            raise AppError("RENEWAL_POLICY_NOT_AVAILABLE",400)
+
+        return HarnessToolResult(
+            summary="检索到的用户当前的保单",
+            data=policy
+        )
+
+    def get_renewal_options(
+            context:ToolExecutionContext,
+            arguments:BaseModel,
+    ) -> HarnessToolResult:
+        # **需要补充的逻辑**：
+        # 1. 从步骤4 的领域模型读取方案，不要在这里重新写死
+        # 2. 返回结构里带options列表，方便agent比较
+        return HarnessToolResult(summary="提供续保候选方案",data=renewal_model.RENEWAL_OPTIONS)
+
+    def submit_renewal_advice(
+            context:ToolExecutionContext,
+            arguments:BaseModel,
+    ) -> HarnessToolResult:
+        # 需要补充的校验逻辑：
+    # 1. 本次运行必须已经调用过 get_policy_context（检查 context.executions） 前置工具是否已经调用
+    # 2. 本次运行必须已经调用过 get_renewal_options
+    # 3. selected_option_code 必须是候选方案之一，不能接受 Agent 编造的新方案
+    # 4. cited_chunk_ids 必须来自本次 search_insurance_knowledge 的返回结果，
+    #    不能引用没检索过的切片
+    # 5. 涉及等待期、保障责任、报销范围等事实性结论时，必须有直接证据；
+    #    没有证据的结论要拒绝
+    # 6. “无法确定”可以没有引用，但 missing_information 不能为空
+    # 7. 校验通过后，把参数构造成步骤 3 的 RenewalAdviceBlock 返回
+        tool_num_get_policy_context = 0
+        option_code_num = 0
+        cited_chunk_ids = arguments.cited_chunk_ids
+
+        selected_option_code = arguments.selected_option_code
+        for execution in context.executions:
+            if execution.name == 'get_policy_context':
+                tool_num_get_policy_context += 1
+            if execution.name == 'get_renewal_options':
+                for option in execution.result.data.items:
+                    if option.option_code == selected_option_code:
+                        option_code_num += 1
+            if execution.name == 'search_insurance_knowledge':
+                if not execution.result.data.items.contains(cited_chunk_ids):
+                    raise AppError("ERROR_CHUNNK_ID","出现不属于本次检索到的切片内容",500)
+
+            if tool_num_get_policy_context == 0:
+                raise AppError("ERROR_STEP","未调用get_policy_context的工具方法",501) 
+            if  option_code_num == 0:
+                raise AppError("ERROR_STEP","selected_option_code 必须是候选方案之一",500) 
+
+
+        decision = arguments.decision
+        missing_information = arguments.missing_information
+        if decision.contains('无法确定'):
+            if missing_information is None:
+                raise AppError("ERROR_PARAMETERS","missing_information 不能为空",500) 
+
+        return HarnessToolResult(
+            summary="校验方案",
+            data=RenewalAdviceBlock(
+                decision=decision,
+                selected_option_code=selected_option_code,
+                selected_option_name=arguments.selected_option_code,
+                premium_cents=arguments.premium_cents,
+                summary=arguments.sumarry,
+                reasons=arguments.reasons,
+                missing_information=missing_information,
+                cited_chunk_ids=cited_chunk_ids
+            )
+        ) 
+
